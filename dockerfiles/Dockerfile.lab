# The sandbox the agent gets a shell in.
#
# Deliberately thin. Everything here is something the agent would otherwise
# have to install on its very first command, in every new chat, before doing
# any actual work. Everything NOT here, it can install itself - that is the
# point of giving it a shell.
#
# Build:  python docker_setup.py

FROM python:3.12-slim

WORKDIR /lab

# One RUN layer, and the apt lists deleted in the same layer. Splitting
# these into separate RUNs would keep the downloaded package index inside
# the image forever, since a later layer cannot shrink an earlier one.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        wget \
        unzip \
        build-essential \
        procps \
        ripgrep \
        jq \
    && rm -rf /var/lib/apt/lists/*

# Preinstalled because almost every data question starts by reaching for
# them, and a cold `pip install pandas` costs the user 40 seconds of
# staring at a status line.
RUN pip install --no-cache-dir \
        requests \
        beautifulsoup4 \
        pandas \
        matplotlib \
        numpy

# Matplotlib with no display attached needs a headless backend, or the
# first plot raises instead of drawing.
ENV MPLBACKEND=Agg
# Unbuffered, so output arrives as it is produced rather than in a lump
# when the process exits.
ENV PYTHONUNBUFFERED=1

# The container has no job of its own. It exists to be exec'd into, so it
# needs a process that never exits and costs nothing while waiting.
CMD ["tail", "-f", "/dev/null"]

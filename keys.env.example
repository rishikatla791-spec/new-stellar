# Stellar configuration template.
#
#   cp keys.env.example keys.env      (then fill in the real values)
#
# keys.env is gitignored. This .example file IS committed, so it must never
# contain a real secret - it documents the shape of the config, nothing more.
#
# A line written as NAME= with nothing after it counts as unset, exactly as
# if it were not there. Optional settings are commented out below; remove
# the # to use one. Then check everything with:
#   .venv/Scripts/python.exe verify_env.py

# --- Required ------------------------------------------------------------
# Signs login cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If this changes, everyone is logged out.
FLASK_SECRET_KEY=

# Gemini keys from Google AI Studio. The key manager rotates through them
# when one hits its limit. Any of these names work, numbered as far as you
# like: PRIMARY_API_KEY, PRIMARY_API_KEY_1.., BACKUP_API_KEY, BACKUP_API_KEY_1..
PRIMARY_API_KEY=
# BACKUP_API_KEY_1=
# BACKUP_API_KEY_2=

# Redis, with a password. Locally, docker_setup.py --secure-redis creates
# the container and writes this line for you. On a server, see
# deploy/deploy_guide.md step 1. Never leave Redis without a password: code
# in the sandbox can reach the host.
REDIS_URL=redis://:<password>@127.0.0.1:6379/0

# SQLite database file, relative to the project folder.
DATABASE_NAME=stellar_local.db

# Who may administer this install: a comma-separated list of email
# addresses. These accounts are approved and made admin when they sign in.
# Nobody else can become admin from the web; see also `flask make-admin`.
# ADMIN_EMAILS=you@example.com

# --- Tools (optional) ----------------------------------------------------
# tavily.com, for web_search. Numbered keys rotate like the Gemini ones.
# TAVILY_API_KEY=
# TAVILY_API_KEY_1=

# YouTube Data API v3 key, for searching videos. Without it, search falls
# back to Tavily restricted to youtube.com; watching videos needs no key.
# YOUTUBE_API_KEY=

# Email to yourself (send_self_email): a Gmail address and a Google *App
# Password* - 16 letters, made under Google Account > Security >
# 2-Step Verification > App passwords. The account password does not work.
# EMAIL_USER=
# EMAIL_PASS=
# Any SMTP-over-SSL server instead of Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- Google sign-in (optional) ---------------------------------------------
# From the Firebase console: Project settings -> General -> Your apps ->
# the web app's config. None of these are secrets; they are shown to every
# visitor of the login page. Leave them unset and the button does not appear.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_APP_ID=

# --- Production (leave unset on your own machine) ------------------------------
# The domain this install is served from; must match nginx's server_name.
# Deployed apps live at <name>.<domain>. Unset means a local install, where
# they are reached as <name>.localhost:5000.
# STELLAR_DOMAIN=example.com

# 1 behind TLS, so the login cookie is never sent over plain http. Leave
# unset for local http development, or you cannot stay logged in.
# SESSION_COOKIE_SECURE=1

# --- Advanced (optional) -------------------------------------------------------
# SSH gateway (ssh_gateway.py). 127.0.0.1 keeps it to this machine; set
# 0.0.0.0 only behind a firewall you control.
# STELLAR_SSH_HOST=127.0.0.1
# STELLAR_SSH_PORT=2222

# Address range for sandbox networks, one /26 per user. Change it only if
# your own network already uses 10.213.0.0/16.
# STELLAR_SANDBOX_POOL=10.213.0.0/16

# 1 turns on Flask's debugger and code reloader for `python app.py`. Never
# on a server: the debugger runs arbitrary code for whoever reaches it.
# FLASK_DEBUG=1

# Stellar configuration template.
#
#   cp keys.env.example keys.env      (then fill in the real values)
#
# keys.env is gitignored. This .example file IS committed, so it must never
# contain a real secret - it documents the shape of the config, nothing more.
#
# Each variable is tagged with the phase that first needs it. Anything tagged
# for a later phase can stay blank until you get there.

# --- Phase 0: minimum to prove the environment works -------------------
# Google AI Studio -> Get API key. Free tier is enough for the whole build.
PRIMARY_API_KEY=

# --- Phase 1: Flask session signing ------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# If this changes, every existing login session is invalidated.
FLASK_SECRET_KEY=

# Path to the SQLite database file, relative to the project root.
DATABASE_NAME=stellar_local.db

# --- Phase 2: Redis ----------------------------------------------------
# Redis carries stream buffers, cancellation signals and key-block state.
REDIS_URL=redis://localhost:6379/0

# --- Phase 4: tools ----------------------------------------------------
# tavily.com - free tier covers web_search
TAVILY_API_KEY=

# --- Phase 7: multi-key rotation ---------------------------------------
# Additional Gemini keys from separate Google accounts. The key manager
# rotates through these when PRIMARY_API_KEY hits a rate limit. Add as
# many as you like following the same numbering.
BACKUP_API_KEY_1=
BACKUP_API_KEY_2=

# --- Phase 8: outbound tools -------------------------------------------
# Gmail address plus a Google *App Password* (not your account password).
EMAIL_USER=
EMAIL_PASS=
# YouTube Data API v3 key, for analyze_youtube_video
YOUTUBE_API_KEY=
# Fernet key for encrypting stored secrets. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
